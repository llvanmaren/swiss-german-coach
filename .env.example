# Copy to .env and chmod 600. Both tokens are REQUIRED and must be different. Generate each with:
#   python -c 'import secrets;print(secrets.token_urlsafe(32))'
# The server refuses to start if a token is missing, shorter than 32 characters, not URL-safe, or a placeholder.
# Connector URL: https://<host>/mcp/<COACH_TOKEN>
COACH_TOKEN=
# Read-only progress page: https://<host>/progress/<COACH_DASH_TOKEN>
COACH_DASH_TOKEN=
# Host headers to accept (applies to every path): your public hostname plus local testing
COACH_HOSTS=coach.example.com,127.0.0.1:*,localhost:*
COACH_DB=data/coach.db
COACH_CONFIG=config.toml
COACH_PORT=8000
# Max requests per minute per client IP (in-process limit)
COACH_RATE_LIMIT=120
